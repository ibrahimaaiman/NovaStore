@model CheckoutInput
@{ViewData["Title"]="Checkout";var lines=(List<CartDisplay>)ViewBag.Lines;var sub=lines.Sum(x=>x.Total);}
<section class="page-banner"><div class="container"><div class="eyebrow">ALMOST THERE</div><h1>Make it <em>yours.</em></h1><p>Just a few details and you're all set.</p></div></section><div class="container checkout-layout"><form asp-action="Index" method="post" class="checkout-form"><h2>Shipping information</h2><div asp-validation-summary="All" class="validation"></div><div class="form-grid"><label>Full name<input asp-for="FullName" placeholder="Your full name" required/></label><label>Email address<input asp-for="Email" type="email" placeholder="you@example.com" required/></label><label>Phone number<input asp-for="Phone" placeholder="Your phone number" required/></label><label>City<input asp-for="City" placeholder="Your city" required/></label><label class="wide">Delivery address<input asp-for="Address" placeholder="Street, building, apartment" required/></label><label class="wide">Order notes (optional)<textarea asp-for="Notes" rows="4" placeholder="Anything we should know?"></textarea></label></div><div class="payment-notice">✧ <div><b>Cash on delivery — demo mode</b><p>This sample storefront does not charge cards or process real payments.</p></div></div><button class="btn btn-dark full">Place order ↗</button></form><aside class="summary"><h3>Your order</h3>@foreach(var item in lines){<div class="checkout-line"><img src="@item.Product.Image" alt=""/><span>@item.Product.Name <small>Qty: @item.Quantity</small></span><b>$@item.Total.ToString("0.00")</b></div>}<div><span>Subtotal</span><b>$@sub.ToString("0.00")</b></div><div><span>Shipping</span><b>@(sub>=200?"FREE":"$15.00")</b></div><div class="summary-total"><span>Total</span><b>$@((sub+(sub>=200?0:15)).ToString("0.00"))</b></div></aside></div>