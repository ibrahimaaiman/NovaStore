@model Product
<article class="product-card"><a asp-controller="Shop" asp-action="Details" asp-route-id="@Model.Id" class="product-photo"><img src="@Model.Image" alt="@Model.Name" loading="lazy"/>@if(!string.IsNullOrEmpty(Model.Badge)){<span class="product-badge">@Model.Badge</span>}<span class="view-pill">Explore ↗</span></a><div class="product-meta"><span>@Model.Category</span><span class="rating">★ @Model.Rating.ToString("0.0")</span></div><a class="product-title" asp-controller="Shop" asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a><div class="product-bottom"><div class="prices"><b>$@Model.Price.ToString("0.00")</b>@if(Model.OldPrice>Model.Price){<del>$@Model.OldPrice.ToString("0.00")</del>}</div><form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString"/><button class="add-round" aria-label="Add @Model.Name to cart" title="Add to bag" @(Model.Stock<=0?"disabled":null)>+</button></form></div></article>