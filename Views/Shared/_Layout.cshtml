@inject NovaStore.Services.StoreService Store
@{var count=Context.Session.GetCart().Sum(x=>x.Quantity);var cats=Store.Products().Select(x=>x.Category).Distinct().Take(5);}
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] | NOVA.</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body>
<div class="announcement">✦ A little something extra — free shipping on orders over $200 <span>✦</span></div>
<header class="header"><div class="container nav"><a class="logo" asp-controller="Home" asp-action="Index">NOVA<span>.</span></a><nav class="navlinks"><a asp-controller="Home" asp-action="Index">Home</a><a asp-controller="Shop" asp-action="Index">Shop all</a>@foreach(var c in cats){<a asp-controller="Shop" asp-action="Index" asp-route-category="@c">@c</a>}</nav><div class="navright"><form asp-controller="Shop" asp-action="Index" method="get" class="navsearch"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg><input name="q" placeholder="Search products..." aria-label="Search products"/></form>@if(Context.Session.GetString("CustomerEmail") is string userEmail){<a class="account-link" asp-controller="Account" asp-action="Profile">Hi, @(Context.Session.GetString("CustomerName")?.Split(' ')[0] ?? "Account")</a><a class="account-link" asp-controller="Account" asp-action="MyOrders">Orders</a><form class="logout-form" asp-controller="Account" asp-action="Logout" method="post"><button type="submit">Log out</button></form>}else{<a class="account-link" asp-controller="Account" asp-action="Login">Log in</a><a class="account-link account-register" asp-controller="Account" asp-action="Register">Create account</a>}<a class="cartlink" asp-controller="Cart" asp-action="Index" aria-label="Shopping bag"><svg viewBox="0 0 24 24"><path d="M4 8h16l-1.5 13h-13L4 8ZM9 9V6a3 3 0 0 1 6 0v3"/></svg><span class="cartcount">@count</span></a><button class="hamburger" id="menuBtn" aria-label="Toggle menu">☰</button></div></div><div class="mobile-nav" id="mobileNav"><a asp-controller="Home" asp-action="Index">Home</a><a asp-controller="Shop" asp-action="Index">Shop all</a>@if(Context.Session.GetString("CustomerEmail") is not null){<a asp-controller="Account" asp-action="Profile">My profile</a><a asp-controller="Account" asp-action="MyOrders">My orders</a>}else{<a asp-controller="Account" asp-action="Login">Log in</a><a asp-controller="Account" asp-action="Register">Create account</a>}@foreach(var c in cats){<a asp-controller="Shop" asp-action="Index" asp-route-category="@c">@c</a>}</div></header>
<main>@RenderBody()</main>
<footer class="footer"><div class="container"><div class="footer-top"><div><a class="logo light" asp-controller="Home" asp-action="Index">NOVA<span>.</span></a><p>Everyday essentials, exceptionally considered.<br/>Discover your next favorite thing.</p></div><div><h4>Explore</h4><a asp-controller="Shop" asp-action="Index">All products</a><a asp-controller="Shop" asp-action="Index" asp-route-category="Electronics">Electronics</a><a asp-controller="Shop" asp-action="Index" asp-route-category="Fashion">Fashion</a></div><div><h4>Support</h4><a href="mailto:hello@example.com">Contact us</a><a asp-controller="Cart" asp-action="Index">Your bag</a><a asp-controller="Admin" asp-action="Login">Store admin</a></div><div><h4>Stay in the loop</h4><p>Good things are coming. Follow our journey.</p><div class="socials"><span>IG</span><span>PIN</span><span>FB</span></div></div></div><div class="footer-bottom"><span>© @DateTime.Now.Year NOVA. All rights reserved.</span><span>Designed for the modern everyday ✦</span></div></div></footer>
@if(TempData["Toast"]!=null){<div class="toast">✓ @TempData["Toast"]</div>}<script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>