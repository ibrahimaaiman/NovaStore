@{ViewData["Title"]="Curated for living";var featured=(List<Product>)ViewBag.Featured;var items=(List<Product>)ViewBag.New;}
<section class="hero"><div class="container hero-grid"><div class="hero-copy"><div class="eyebrow"><span class="eyedot"></span> THE NEW STANDARD IN EVERYDAY</div><h1>Good design.<br/><em>Great living.</em></h1><p>Thoughtfully selected pieces that make every day feel a little more extraordinary. Find what speaks to you.</p><div class="hero-actions"><a class="btn btn-dark" asp-controller="Shop" asp-action="Index">Explore collection <span>↗</span></a><a class="text-link" href="#featured">Discover favorites <span>↘</span></a></div><div class="hero-proof"><div class="avatars"><span>J</span><span>M</span><span>A</span><span>+</span></div><div><b>4.9/5 <span class="stars">★★★★★</span></b><small>Loved by 2,000+ happy shoppers</small></div></div></div><div class="hero-visual"><img src="https://images.unsplash.com/photo-1503602642458-232111445657?auto=format&fit=crop&w=1200&q=90" alt="Modern designer chair in a minimal interior"/><div class="hero-image-tag"><span class="mini-dot"></span><div><b>Designed to inspire</b><small>The art of everyday living</small></div><span>↗</span></div><div class="hero-orbit">NEW<br/>DROP <span>✳</span></div></div></div><div class="container hero-foot"><span>01 / CURATED COLLECTION</span><span>SCROLL TO EXPLORE ↓</span></div></section>
<section class="benefits container"><div><span class="benefit-icon">✧</span><div><b>Thoughtfully curated</b><small>Only the things we truly love</small></div></div><div><span class="benefit-icon">↗</span><div><b>Free shipping over $200</b><small>Delivered to your doorstep</small></div></div><div><span class="benefit-icon">♡</span><div><b>Made for your lifestyle</b><small>Quality you can count on</small></div></div></section>
<section class="section container" id="featured"><div class="section-heading"><div><div class="eyebrow">✳ HANDPICKED FOR YOU</div><h2>The crowd <em>favorites.</em></h2><p>Meet the pieces everyone keeps coming back for.</p></div><a class="text-link" asp-controller="Shop" asp-action="Index">Shop all products ↗</a></div><div class="product-grid">@foreach(var product in featured){<partial name="_ProductCard" model="product"/>}</div></section>
<section class="editorial container"><div class="editorial-img"><img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=1100&q=85" alt="Contemporary fashion collection" loading="lazy"/></div><div class="editorial-content"><span class="eyebrow">THE NOVA EDIT / 2026</span><h2>Less ordinary.<br/><em>More you.</em></h2><p>Discover a collection of expressive essentials. Made to be worn, loved, and lived in — on your terms.</p><a class="btn btn-light" asp-controller="Shop" asp-action="Index" asp-route-category="Fashion">Explore fashion ↗</a><span class="editorial-num">N° 01 — THE EDIT</span></div></section>
<section class="section container"><div class="section-heading"><div><div class="eyebrow">DISCOVER SOMETHING NEW</div><h2>Fresh <em>finds.</em></h2><p>A little inspiration for your next favorite thing.</p></div><a class="text-link" asp-controller="Shop" asp-action="Index">View the collection ↗</a></div><div class="product-grid">@foreach(var product in items.Take(8)){<partial name="_ProductCard" model="product"/>}</div></section>
<section class="newsletter"><div class="container newsletter-inner"><div><span class="eyebrow">✳ A LITTLE NOTE FROM US</span><h2>Good things are <em>coming.</em></h2><p>New drops, fresh inspiration, and a little something special.</p></div><a class="btn btn-dark" href="mailto:hello@example.com?subject=Join%20NOVA%20updates">Say hello ↗</a></div></section>