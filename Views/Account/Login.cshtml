@model NovaStore.Models.LoginInput
@{ViewData["Title"]="Log in";}
<section class="account-page"><div class="account-card"><div class="eyebrow">GOOD TO SEE YOU AGAIN</div><h1>Welcome <em>back.</em></h1><p class="account-intro">Log in to view your profile and order history.</p><form asp-action="Login" method="post" class="account-form"><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"/><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="Email">Email address</label><input asp-for="Email" autocomplete="email" placeholder="you@example.com"/><span asp-validation-for="Email" class="field-error"></span><label asp-for="Password">Password</label><input asp-for="Password" autocomplete="current-password" placeholder="Your password"/><span asp-validation-for="Password" class="field-error"></span><label class="remember-row"><input asp-for="RememberMe"/> Keep me signed in for this session</label><button class="btn btn-dark full" type="submit">Log in <span>↗</span></button></form><p class="account-switch">New to NOVA? <a asp-action="Register">Create an account</a></p></div></section>
