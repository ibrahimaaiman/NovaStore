@model List<NovaStore.Models.Order>
@{ViewData["Title"]="My orders";}
<section class="container orders-page"><div class="eyebrow">YOUR NOVA ACCOUNT</div><h1>My <em>orders.</em></h1><p class="account-intro">A little history of the things you picked.</p>@if(Model.Count==0){<div class="orders-empty"><div class="empty-icon">↗</div><h2>No orders yet</h2><p>When you place an order, it will show up here.</p><a class="btn btn-dark" asp-controller="Shop" asp-action="Index">Explore the shop ↗</a></div>}else{<div class="orders-list">@foreach(var order in Model){<article class="order-card"><div class="order-card-head"><div><small>ORDER REFERENCE</small><h2>@order.Id</h2></div><span class="order-status">@order.Status</span></div><div class="order-card-meta"><span>@order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span><span>@order.Items.Sum(x=>x.Quantity) item(s)</span><strong>$@order.Total.ToString("0.00")</strong></div><div class="order-products">@foreach(var item in order.Items){<div><img src="@item.Image" alt="@item.Name"/><span>@item.Name <small>Qty: @item.Quantity</small></span><b>$@((item.Price*item.Quantity).ToString("0.00"))</b></div>}</div></article>}}</div>}<a class="text-link" asp-controller="Account" asp-action="Profile">← Back to profile</a></section>
