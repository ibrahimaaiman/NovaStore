@model NovaStore.Models.RegisterInput
@{ViewData["Title"]="Create account";}
<section class="account-page"><div class="account-card"><div class="eyebrow">WELCOME TO NOVA</div><h1>Create your <em>account.</em></h1><p class="account-intro">Save your details and keep track of your orders in one place.</p><form asp-action="Register" method="post" class="account-form"><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="FullName">Full name</label><input asp-for="FullName" autocomplete="name" placeholder="Your full name"/><span asp-validation-for="FullName" class="field-error"></span><label asp-for="Email">Email address</label><input asp-for="Email" autocomplete="email" placeholder="you@example.com"/><span asp-validation-for="Email" class="field-error"></span><label asp-for="Phone">Phone number <small>(optional)</small></label><input asp-for="Phone" autocomplete="tel" placeholder="Your phone number"/><span asp-validation-for="Phone" class="field-error"></span><label asp-for="Password">Password</label><input asp-for="Password" autocomplete="new-password" placeholder="At least 8 characters"/><span asp-validation-for="Password" class="field-error"></span><label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Repeat your password"/><span asp-validation-for="ConfirmPassword" class="field-error"></span><button class="btn btn-dark full" type="submit">Create account <span>↗</span></button></form><p class="account-switch">Already have an account? <a asp-action="Login">Log in</a></p></div></section>
