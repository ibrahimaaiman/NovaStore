@model NovaStore.Models.ProfileInput
@{ViewData["Title"]="My profile";}
<section class="account-page"><div class="account-card account-card-wide"><div class="eyebrow">YOUR NOVA ACCOUNT</div><h1>My <em>profile.</em></h1><p class="account-intro">Keep your contact details up to date.</p><form asp-action="Profile" method="post" class="account-form"><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="FullName">Full name</label><input asp-for="FullName" autocomplete="name"/><span asp-validation-for="FullName" class="field-error"></span><label asp-for="Email">Email address</label><input asp-for="Email" autocomplete="email"/><span asp-validation-for="Email" class="field-error"></span><label asp-for="Phone">Phone number</label><input asp-for="Phone" autocomplete="tel"/><span asp-validation-for="Phone" class="field-error"></span><button class="btn btn-dark full" type="submit">Save changes <span>↗</span></button></form><div class="account-actions"><a class="btn btn-light" asp-action="MyOrders">View my orders ↗</a><form asp-action="Logout" method="post"><button class="text-link" type="submit">Log out</button></form></div></div></section>
