@model Product
@{ViewData["Title"]=Model.Name;var related=(List<Product>)ViewBag.Related;}
<div class="container detail-page"><div class="breadcrumbs"><a asp-controller="Home" asp-action="Index">Home</a> / <a asp-action="Index">Shop</a> / @Model.Category</div><div class="detail-grid"><div class="detail-photo"><img src="@Model.Image" alt="@Model.Name"/>@if(!string.IsNullOrEmpty(Model.Badge)){<span class="product-badge">@Model.Badge</span>}</div><div class="detail-info"><span class="eyebrow">NOVA / @Model.Category.ToUpper()</span><h1>@Model.Name</h1><div class="detail-rating"><span>★★★★★</span> @Model.Rating.ToString("0.0") / 5 · Customer favorite</div><div class="detail-prices"><b>$@Model.Price.ToString("0.00")</b>@if(Model.OldPrice>Model.Price){<del>$@Model.OldPrice.ToString("0.00")</del><span class="sale">SAVE @Math.Round((Model.OldPrice-Model.Price)/Model.OldPrice*100)%</span>}</div><p class="detail-description">@Model.Description</p><div class="detail-rule"></div><div class="stock">@(Model.Stock>0?"● In stock — ready to ship":"● Out of stock")</div><form asp-controller="Cart" asp-action="Add" method="post" class="detail-form"><input type="hidden" name="id" value="@Model.Id"/><label for="qty">Quantity</label><div class="buy-row"><input id="qty" type="number" name="quantity" min="1" max="@Model.Stock" value="1"/><button class="btn btn-dark" @(Model.Stock<=0?"disabled":null)>Add to bag <span>↗</span></button></div></form><div class="detail-perks"><div>✧ Carefully curated quality</div><div>↗ Free shipping over $200</div><div>♡ Made for everyday living</div></div></div></div>@if(related.Count>0){<section class="section"><div class="section-heading"><div><div class="eyebrow">YOU MAY ALSO LOVE</div><h2>More to <em>explore.</em></h2></div></div><div class="product-grid">@foreach(var product in related){<partial name="_ProductCard" model="product"/>}</div></section>}</div>