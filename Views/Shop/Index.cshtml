@model List<Product>
@{ViewData["Title"]="Shop collection";var categories=(List<string>)ViewBag.Categories;}
<section class="page-banner"><div class="container"><div class="eyebrow">HOME / SHOP</div><h1>Find your <em>favorite.</em></h1><p>Discover pieces that make the everyday extraordinary.</p></div></section><div class="container shop-layout"><aside class="filters"><h3>Categories</h3><a class="@(ViewBag.Category==null?"selected":"")" asp-action="Index" asp-route-q="@ViewBag.Query">All products <span>↗</span></a>@foreach(var c in categories){<a class="@(ViewBag.Category==c?"selected":"")" asp-action="Index" asp-route-category="@c" asp-route-q="@ViewBag.Query">@c <span>↗</span></a>}<div class="filter-note">✳ Good things, great prices.<br/>Free shipping on orders $200+</div></aside><div class="shop-main"><form method="get" class="shop-toolbar"><input type="hidden" name="category" value="@ViewBag.Category"/><input class="search-field" name="q" value="@ViewBag.Query" placeholder="Search the collection..."/><span>@Model.Count products</span><select name="sort" onchange="this.form.submit()"><option value="featured" selected="@(ViewBag.Sort=="featured")">Featured</option><option value="price-low" selected="@(ViewBag.Sort=="price-low")">Price: low to high</option><option value="price-high" selected="@(ViewBag.Sort=="price-high")">Price: high to low</option><option value="name" selected="@(ViewBag.Sort=="name")">Name A–Z</option></select><button class="btn btn-dark search-btn">Search</button></form>@if(Model.Count==0){<div class="empty"><h2>No products found.</h2><p>Try another search or browse all products.</p><a class="btn btn-dark" asp-action="Index">Browse all ↗</a></div>}else{<div class="product-grid shop-grid">@foreach(var product in Model){<partial name="_ProductCard" model="product"/>}</div>}</div></div>