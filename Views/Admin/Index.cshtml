@model List<Product>
@{ViewData["Title"]="Admin dashboard";var orders=(List<Order>)ViewBag.Orders;}
<div class="container admin-page"><div class="section-heading"><div><div class="eyebrow">STORE MANAGEMENT</div><h1>Admin <em>dashboard.</em></h1></div><div><a class="btn btn-dark" asp-action="Edit">+ Add product</a> <a class="text-link" asp-action="Logout">Log out</a></div></div><div class="stats"><div><span>PRODUCTS</span><b>@Model.Count</b></div><div><span>ORDERS</span><b>@orders.Count</b></div><div><span>REVENUE (DEMO)</span><b>$@orders.Where(x=>x.Status!="Cancelled").Sum(x=>x.Total).ToString("0.00")</b></div></div><h2>Products</h2><div class="table-wrap"><table class="admin-table"><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Actions</th></tr></thead><tbody>@foreach(var item in Model){<tr><td><img src="@item.Image" alt=""/> @item.Name</td><td>@item.Category</td><td>$@item.Price</td><td>@item.Stock</td><td><a asp-action="Edit" asp-route-id="@item.Id">Edit</a> <form asp-action="Delete" method="post" class="inline" onsubmit="return confirm('Delete this product?')"><input type="hidden" name="id" value="@item.Id"/><button>Delete</button></form></td></tr>}</tbody></table></div><h2>Recent orders</h2><div class="table-wrap"><table class="admin-table"><thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Date</th><th>Status</th></tr></thead><tbody>@foreach(var o in orders){<tr><td>@o.Id</td><td>@o.Customer.FullName<br/><small>@o.Customer.Email · @o.Customer.Phone<br/>@o.Customer.Address, @o.Customer.City</small></td><td>$@o.Total.ToString("0.00")</td><td>@o.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td><form asp-action="Status" method="post" class="inline"><input type="hidden" name="id" value="@o.Id"/><select name="status" onchange="this.form.submit()">@foreach(var s in new[]{"New","Processing","Shipped","Delivered","Cancelled"}){<option value="@s" selected="@(s==o.Status)">@s</option>}</select><button>Save</button></form></td></tr>}</tbody></table></div></div>