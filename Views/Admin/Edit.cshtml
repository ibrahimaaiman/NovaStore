@model Product
@{ViewData["Title"]=Model.Id==0?"Add product":"Edit product";}<div class="container admin-edit"><div class="eyebrow">STORE MANAGEMENT</div><h1>@(Model.Id==0?"Add a":"Edit") <em>product.</em></h1><form asp-action="Edit" method="post" class="checkout-form"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="validation"></div><div class="form-grid"><label>Name<input asp-for="Name" required/></label><label>Category<input asp-for="Category" required/></label><label>Price ($)<input asp-for="Price" type="number" step="0.01" min="0"/></label><label>Old price ($)<input asp-for="OldPrice" type="number" step="0.01" min="0"/></label><label>Image URL<input asp-for="Image" placeholder="https://..."/></label><label>Stock<input asp-for="Stock" type="number" min="0"/></label><label>Badge<input asp-for="Badge"/></label><label>Rating<input asp-for="Rating" type="number" min="0" max="5" step="0.1"/></label><label class="wide">Description<textarea asp-for="Description" rows="4"></textarea></label><label class="wide checklabel"><input asp-for="Featured" type="checkbox"/> Featured product</label></div><button class="btn btn-dark">Save product ↗</button> <a class="text-link" asp-action="Index">Cancel</a></form></div>