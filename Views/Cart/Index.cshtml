@model List<CartDisplay>
@{ViewData["Title"]="Your bag";var sub=Model.Sum(x=>x.Total);}
<section class="page-banner"><div class="container"><div class="eyebrow">YOUR SELECTION</div><h1>Your shopping <em>bag.</em></h1><p>Good choices look good on you.</p></div></section><div class="container cart-page">@if(Model.Count==0){<div class="empty"><div class="empty-icon">♡</div><h2>Your bag is waiting.</h2><p>Looks like you haven't added anything yet.</p><a class="btn btn-dark" asp-controller="Shop" asp-action="Index">Explore the collection ↗</a></div>}else{<div class="cart-layout"><div><h3>Your items (@Model.Sum(x=>x.Quantity))</h3>@foreach(var item in Model){<div class="cart-item"><a asp-controller="Shop" asp-action="Details" asp-route-id="@item.Product.Id"><img src="@item.Product.Image" alt="@item.Product.Name"/></a><div class="cart-item-info"><span class="eyebrow">@item.Product.Category</span><a class="cart-name" asp-controller="Shop" asp-action="Details" asp-route-id="@item.Product.Id">@item.Product.Name</a><b>$@item.Product.Price.ToString("0.00")</b><form asp-action="Update" method="post" class="qty-form"><input type="hidden" name="id" value="@item.Product.Id"/><input type="number" min="0" max="@item.Product.Stock" name="quantity" value="@item.Quantity"/><button>Update</button></form></div><div class="cart-item-end"><b>$@item.Total.ToString("0.00")</b><form asp-action="Remove" method="post"><input type="hidden" name="id" value="@item.Product.Id"/><button class="remove-btn">Remove ×</button></form></div></div>}<a class="text-link" asp-controller="Shop" asp-action="Index">← Continue shopping</a></div><aside class="summary"><h3>Order summary</h3><div><span>Subtotal</span><b>$@sub.ToString("0.00")</b></div><div><span>Shipping</span><b>@(sub>=200?"FREE":"$15.00")</b></div><div class="summary-total"><span>Total</span><b>$@((sub+(sub>=200?0:15)).ToString("0.00"))</b></div><p>@(sub>=200?"✓ You've unlocked free shipping!":$"Add ${(200-sub):0.00} more for free shipping.")</p><a class="btn btn-dark full" asp-controller="Checkout" asp-action="Index">Proceed to checkout ↗</a><small>Secure demo checkout · No online payment collected</small></aside></div>}</div>