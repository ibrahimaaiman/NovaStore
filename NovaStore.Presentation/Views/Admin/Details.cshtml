@model Product
@{ ViewData["Title"] = "Product details"; }
<div class="container admin-edit"><div class="eyebrow">STORE MANAGEMENT</div><h1>Product <em>details.</em></h1><div class="detail-grid"><div class="detail-photo"><img src="@Model.Image" alt="@Model.Name"/></div><div class="detail-info"><h2>@Model.Name</h2><p>@Model.Description</p><p>Category: @Model.Category</p><p>Price: $@Model.Price.ToString("0.00")</p><p>Stock: @Model.Stock</p><p>Rating: @Model.Rating</p><a class="btn btn-dark" asp-action="Edit" asp-route-id="@Model.Id">Edit product</a> <a class="text-link" asp-action="Index">Back to dashboard</a></div></div></div>
